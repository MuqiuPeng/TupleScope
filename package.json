{
  "name": "tuplescope",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.2",
  "type": "module",
  "scripts": {
    "build": "tsc -b packages/core packages/secrets packages/handoff packages/expr packages/http-runner packages/db-postgres packages/scenario-engine packages/report packages/conformance packages/workspace apps/runtime apps/cli apps/mcp",
    "typecheck": "pnpm build && tsc -p tsconfig.check.json",
    "start": "pnpm --filter @tuplescope/runtime start",
    "demo:db": "pnpm --filter @tuplescope/example-demo-bank db",
    "demo:api": "pnpm --filter @tuplescope/example-demo-bank api",
    "demo:shop": "pnpm --filter @tuplescope/example-shopfront api",
    "test": "pnpm typecheck && pnpm -r --no-bail run test",
    "url": "pnpm --filter @tuplescope/runtime url"
  },
  "devDependencies": {
    "@tuplescope/cli": "workspace:*",
    "@tuplescope/mcp": "workspace:*",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}